@model PositionsViewModel
@{
    ViewData["Title"] = "Positions";
}

<div class="d-flex justify-content-between align-items-baseline">
    <h1 class="h4">Positions</h1>
    @if (Model.Rows.Count > 0)
    {
        <a class="btn btn-sm btn-outline-secondary" asp-action="Export">Export CSV</a>
    }
</div>

@if (Model.Rows.Count == 0)
{
    <p class="text-muted">No positions. Book a trade from the <a asp-controller="Chain" asp-action="Index">chain</a>.</p>
}
else
{
    <table class="table table-sm table-hover table-desk">
        <thead>
            <tr>
                <th data-sort="text">Underlying</th>
                <th data-sort="text">Symbol</th>
                <th data-sort="num" class="num">Quantity</th>
                <th data-sort="num" class="num">Avg price</th>
                <th data-sort="num" class="num">Mark</th>
                <th data-sort="num" class="num">Market value</th>
                <th data-sort="num" class="num">Unrealized</th>
                <th data-sort="num" class="num">Realized</th>
                <th data-sort="num" class="num" title="shares">Delta</th>
                <th data-sort="num" class="num" title="shares per $1 move">Gamma</th>
                <th data-sort="num" class="num" title="$ per vol point">Vega</th>
                <th data-sort="num" class="num" title="$ per day">Theta</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                var p = row.Position;
                <tr>
                    <td>@p.Underlying</td>
                    <td class="font-monospace">@p.Symbol</td>
                    <td class="num">@p.Quantity.ToString("N0")</td>
                    <td class="num">@Fmt.Price(p.AveragePrice)</td>
                    <td class="num">@Fmt.Price(p.Mark)</td>
                    <td class="num" data-value="@p.MarketValue">@Fmt.Money(p.MarketValue)</td>
                    <td class="num @Fmt.Sign(p.UnrealizedPnl)" data-value="@p.UnrealizedPnl">@Fmt.Money(p.UnrealizedPnl)</td>
                    <td class="num @Fmt.Sign(p.RealizedPnl)" data-value="@p.RealizedPnl">@Fmt.Money(p.RealizedPnl)</td>
                    <td class="num" data-value="@row.Delta">@Fmt.Num(row.Delta)</td>
                    <td class="num" data-value="@row.Gamma">@Fmt.Num(row.Gamma, 1)</td>
                    <td class="num" data-value="@row.Vega">@Fmt.Money(row.Vega)</td>
                    <td class="num @Fmt.Sign(row.Theta)" data-value="@row.Theta">@Fmt.Money(row.Theta)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="fw-semibold">
                <td colspan="5">Total</td>
                <td class="num">@Fmt.Money(Model.TotalMarketValue)</td>
                <td class="num @Fmt.Sign(Model.TotalUnrealized)">@Fmt.Money(Model.TotalUnrealized)</td>
                <td class="num @Fmt.Sign(Model.TotalRealized)">@Fmt.Money(Model.TotalRealized)</td>
                <td colspan="2"></td>
                <td class="num">@Fmt.Money(Model.TotalVega)</td>
                <td class="num @Fmt.Sign(Model.TotalTheta)">@Fmt.Money(Model.TotalTheta)</td>
            </tr>
        </tfoot>
    </table>
}
